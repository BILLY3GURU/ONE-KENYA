<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AI Integrity Dashboard - WaziAI</title>
    <link
      href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css"
      rel="stylesheet"
    />
    <link href="/css/styles.css" rel="stylesheet" />
  </head>
  <body>
    <%- include('partials/navigation', { currentPage: 'ai-dashboard' }) %>

    <div class="min-h-screen pt-20">
      <section
        class="py-20 bg-gradient-to-br from-black to-gray-900 text-white"
      >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-16">
            <div
              class="inline-block px-4 py-2 bg-green-600/20 border border-green-600/50 rounded-full mb-6"
            >
              <span class="text-green-500 text-sm font-semibold"
                >AI INTEGRITY DASHBOARD</span
              >
            </div>
            <h1 class="text-4xl sm:text-6xl font-bold mb-6">
              Real-Time AI Analysis
              <br />
              <span
                class="bg-gradient-to-r from-green-600 to-blue-600 bg-clip-text text-transparent"
              >
                Integrity Monitoring
              </span>
            </h1>
            <p class="text-xl text-gray-300 max-w-3xl mx-auto">
              Live AI-powered oversight detecting fraud, waste, and corruption
              across government operations.
            </p>
          </div>
        </div>
      </section>

      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <!-- AI Analysis Controls -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <div class="bg-gray-50 rounded-xl p-6 text-center">
              <div
                class="w-16 h-16 bg-blue-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-white text-2xl">👥</span>
              </div>
              <h3 class="text-xl font-bold mb-2">Ghost Worker Scan</h3>
              <p class="text-gray-600 mb-4">
                Analyze payroll data for phantom employees
              </p>
              <button
                id="scan-ghost-workers"
                class="bg-blue-600 text-white px-6 py-2 rounded-lg hover:bg-blue-700 transition-colors"
              >
                Run Analysis
              </button>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 text-center">
              <div
                class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-white text-2xl">🛒</span>
              </div>
              <h3 class="text-xl font-bold mb-2">Procurement Audit</h3>
              <p class="text-gray-600 mb-4">
                Detect fraudulent contracts and tenders
              </p>
              <button
                id="scan-procurement"
                class="bg-red-600 text-white px-6 py-2 rounded-lg hover:bg-red-700 transition-colors"
              >
                Run Analysis
              </button>
            </div>

            <div class="bg-gray-50 rounded-xl p-6 text-center">
              <div
                class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-4"
              >
                <span class="text-white text-2xl">💰</span>
              </div>
              <h3 class="text-xl font-bold mb-2">Revenue Monitoring</h3>
              <p class="text-gray-600 mb-4">
                Identify tax evasion and revenue leaks
              </p>
              <button
                id="scan-revenue"
                class="bg-green-600 text-white px-6 py-2 rounded-lg hover:bg-green-700 transition-colors"
              >
                Run Analysis
              </button>
            </div>
          </div>

          <!-- Results Display -->
          <div id="results-container" class="hidden">
            <div class="bg-gray-50 rounded-xl p-8 mb-8">
              <h2 class="text-2xl font-bold mb-6">Analysis Results</h2>
              <div id="results-content"></div>
            </div>
          </div>

          <!-- Integrity Report -->
          <div
            class="bg-gradient-to-r from-black to-gray-900 rounded-2xl p-8 text-white"
          >
            <h2 class="text-3xl font-bold mb-8 text-center">
              Integrity Report Summary
            </h2>
            <div
              id="integrity-report"
              class="grid grid-cols-1 md:grid-cols-4 gap-6"
            >
              <!-- Report will be populated by JavaScript -->
            </div>
          </div>
        </div>
      </section>
    </div>

    <%- include('partials/footer') %>

    <script src="/js/app.js"></script>
    <script>
      // AI Dashboard functionality
      document.addEventListener("DOMContentLoaded", function () {
        // Load integrity report on page load
        loadIntegrityReport();

        // Ghost Worker Scan
        document
          .getElementById("scan-ghost-workers")
          .addEventListener("click", async function () {
            await runAnalysis("/api/ai/ghost-workers", "Ghost Worker Analysis");
          });

        // Procurement Fraud Scan
        document
          .getElementById("scan-procurement")
          .addEventListener("click", async function () {
            await runAnalysis(
              "/api/ai/procurement-fraud",
              "Procurement Fraud Analysis"
            );
          });

        // Revenue Leak Scan
        document
          .getElementById("scan-revenue")
          .addEventListener("click", async function () {
            await runAnalysis("/api/ai/revenue-leak", "Revenue Leak Analysis");
          });

        async function runAnalysis(endpoint, title) {
          try {
            const response = await fetch(endpoint);
            const data = await response.json();

            if (data.success) {
              displayResults(title, data);
            } else {
              alert("Analysis failed: " + data.error);
            }
          } catch (error) {
            alert("Error running analysis: " + error.message);
          }
        }

        function displayResults(title, data) {
          const container = document.getElementById("results-container");
          const content = document.getElementById("results-content");

          let html = `<h3 class="text-xl font-bold mb-4">${title}</h3>`;

          if (data.results) {
            html +=
              '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">';

            data.results.forEach((result) => {
              const riskColor =
                result.risk_score > 0.7
                  ? "bg-red-100 border-red-300"
                  : result.risk_score > 0.4
                  ? "bg-yellow-100 border-yellow-300"
                  : "bg-green-100 border-green-300";

              html += `
                <div class="border rounded-lg p-4 ${riskColor}">
                  <div class="font-semibold">${
                    result.employee_id ||
                    result.contract_id ||
                    result.transaction_id
                  }</div>
                  <div class="text-sm">Risk Score: ${(
                    result.risk_score * 100
                  ).toFixed(1)}%</div>
                  <div class="text-sm">Flagged: ${
                    result.is_ghost_worker ||
                    result.is_fraudulent ||
                    result.is_leak
                      ? "Yes"
                      : "No"
                  }</div>
                </div>
              `;
            });

            html += "</div>";
          }

          if (data.patterns) {
            html +=
              '<h4 class="text-lg font-bold mt-6 mb-4">Detected Patterns</h4>';
            html += '<div class="grid grid-cols-1 md:grid-cols-2 gap-4">';

            if (data.patterns.high_risk_sectors) {
              data.patterns.high_risk_sectors.forEach((sector) => {
                html += `
                  <div class="bg-red-50 border border-red-200 rounded-lg p-4">
                    <div class="font-semibold text-red-800">${
                      sector.sector
                    }</div>
                    <div class="text-sm text-red-600">Avg Risk: ${(
                      sector.average_risk * 100
                    ).toFixed(1)}%</div>
                    <div class="text-sm text-red-600">Transactions: ${
                      sector.transaction_count
                    }</div>
                  </div>
                `;
              });
            }

            html += "</div>";
          }

          content.innerHTML = html;
          container.classList.remove("hidden");
        }

        async function loadIntegrityReport() {
          try {
            const response = await fetch("/api/integrity-report");
            const data = await response.json();

            const reportDiv = document.getElementById("integrity-report");
            reportDiv.innerHTML = `
              <div class="text-center">
                <div class="text-3xl font-bold text-green-400 mb-2">KES ${data.summary.totalSavings.toLocaleString()}</div>
                <div class="text-sm text-gray-300">Total Savings</div>
              </div>
              <div class="text-center">
                <div class="text-3xl font-bold text-blue-400 mb-2">${
                  data.summary.totalGhostWorkers
                }</div>
                <div class="text-sm text-gray-300">Ghost Workers Eliminated</div>
              </div>
              <div class="text-center">
                <div class="text-3xl font-bold text-red-400 mb-2">${
                  data.summary.totalFraudDetected
                }</div>
                <div class="text-sm text-gray-300">Fraud Cases Detected</div>
              </div>
              <div class="text-center">
                <div class="text-3xl font-bold text-purple-400 mb-2">${
                  data.summary.aiAnalysesCount
                }</div>
                <div class="text-sm text-gray-300">AI Analyses Performed</div>
              </div>
            `;
          } catch (error) {
            console.error("Error loading integrity report:", error);
          }
        }
      });
    </script>
  </body>
</html>
